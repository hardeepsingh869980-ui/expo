            <Text style={{ fontWeight: '700' }}>{it.juice.name}</Text>
            <Text>${it.juice.price.toFixed(2)} x {it.qty} = ${(it.juice.price * it.qty).toFixed(2)}</Text>
            <View style={{ flexDirection: 'row', marginTop: 8 }}>
              <TouchableOpacity style={styles.qtyBtn} onPress={() => changeQty(it.id, it.qty - 1)}><Text>-</Text></TouchableOpacity>
              <View style={styles.qtyBox}><Text>{it.qty}</Text></View>
              <TouchableOpacity style={styles.qtyBtn} onPress={() => changeQty(it.id, it.qty + 1)}><Text>+</Text></TouchableOpacity>
              <TouchableOpacity style={[styles.qtyBtn, { marginLeft: 12 }]} onPress={() => removeFromCart(it.id)}><Text>Remove</Text></TouchableOpacity>
