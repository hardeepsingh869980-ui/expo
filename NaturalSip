function MenuScreen({ params, setScreen }) {
  const { addToCart } = useCart();
  const { category, id } = params || {};

  if (id) {
    const juice = JUICES.find(j => j.id === id);
    if (!juice) return <Text>Not found</Text>;
    return (
      <ScrollView style={{ padding: 16 }}>
        <Image source={{ uri: juice.img }} style={{ height: 220, borderRadius: 12 }} />
        <Text style={[styles.h1, { marginTop: 12 }]}>{juice.name}</Text>
        <Text style={{ color: '#666', marginBottom: 8 }}>{juice.category}</Text>
        <Text style={{ marginBottom: 12 }}>{juice.desc}</Text>
        <Text style={{ fontWeight: '700', marginBottom: 12 }}>${juice.price.toFixed(2)}</Text>
        <TouchableOpacity style={styles.primaryBtn} onPress={() => { addToCart(juice); Alert.alert('Added', `${juice.name} added to cart`); }}>
          <Text style={{ color: '#fff', fontWeight: '700' }}>Add to cart</Text>
        </TouchableOpacity>
      </ScrollView>
    );
  }

  const juices = category ? JUICES.filter(j => j.category === category) : JUICES;

  return (
    <FlatList
      data={juices}
      keyExtractor={i => i.id}
      contentContainerStyle={{ padding: 16 }}
      renderItem={({ item }) => <JuiceCard juice={item} onAdd={(j) => addToCart(j)} />}
    />
  );
}

