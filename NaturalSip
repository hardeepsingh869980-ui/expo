function CheckoutScreen({ setScreen }) {
  const { items, subtotal, clearCart } = useCart();
  const [name, setName] = useState('');
  const [phone, setPhone] = useState('');
  const [address, setAddress] = useState('');

  function placeOrder() {
    if (!name || !phone || !address) {
      Alert.alert('Missing info', 'Please fill name, phone, and address');
      return;
    }
    // Mock placing order
    const order = { id: Date.now().toString(), name, phone, address, items, total: subtotal };
    clearCart();
    Alert.alert('Order placed', `Thanks ${name}! Order #${order.id} has been placed.`);
    setScreen({ name: 'home' });
  }

  return (
    <ScrollView style={{ padding: 16 }}>
      <Text style={styles.h1}>Checkout</Text>
      <TextInput placeholder="Full name" style={styles.input} value={name} onChangeText={setName} />
      <TextInput placeholder="Phone number" style={styles.input} value={phone} onChangeText={setPhone} keyboardType="phone-pad" />
      <TextInput placeholder="Delivery address" style={[styles.input, { height: 80 }]} value={address} onChangeText={setAddress} multiline />

      <View style={{ marginTop: 12 }}>
        <Text style={{ fontWeight: '700' }}>Order Summary</Text>
        {items.map(it => (
          <Text key={it.id}>{it.qty} x {it.juice.name} - ${(it.qty * it.juice.price).toFixed(2)}</Text>
        ))}
        <Text style={{ marginTop: 8, fontWeight: '700' }}>Total: ${subtotal.toFixed(2)}</Text>
      </View>

      <TouchableOpacity style={[styles.primaryBtn, { marginTop: 16 }]} onPress={placeOrder}>
        <Text style={{ color: '#fff', fontWeight: '700' }}>Place Order (Mock)</Text>
      </TouchableOpacity>
    </ScrollView>
  );
}

