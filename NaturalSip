// ---------- App Root (simple screen manager) ----------
export default function App() {
  const [screen, setScreen] = useState({ name: 'home', params: {} });

  return (
    <CartProvider>
      <SafeAreaView style={styles.container}>
        <AppInner screen={screen} setScreen={setScreen} />
        <StatusBar style="auto" />
      </SafeAreaView>
    </CartProvider>
  );
}

function AppInner({ screen, setScreen }) {
  const { items } = useCart();
  const cartCount = items.reduce((s, i) => s + i.qty, 0);

  function go(name, params) {
    setScreen({ name, params });
  }

  return (
    <View style={{ flex: 1 }}>
      <Header title="NaturalSip" onViewCart={() => go('cart')} cartCount={cartCount} />

      {screen.name === 'home' && <HomeScreen setScreen={setScreen} />}
      {screen.name === 'menu' && <MenuScreen params={screen.params} setScreen={setScreen} />}
      {screen.name === 'cart' && <CartScreen setScreen={setScreen} />}
      {screen.name === 'checkout' && <CheckoutScreen setScreen={setScreen} />}
      {screen.name === 'profile' && <ProfileScreen />}
      {screen.name === 'admin' && <AdminScreen />}

      <View style={styles.bottomNav}>
        <TouchableOpacity onPress={() => go('home')} style={styles.navBtn}><Text>Home</Text></TouchableOpacity>
        <TouchableOpacity onPress={() => go('menu')} style={styles.navBtn}><Text>Menu</Text></TouchableOpacity>
        <TouchableOpacity onPress={() => go('cart')} style={styles.navBtn}><Text>Cart ({cartCount})</Text></TouchableOpacity>
        <TouchableOpacity onPress={() => go('profile')} style={styles.navBtn}><Text>Profile</Text></TouchableOpacity>
      </View>
    </View>
  );
}

