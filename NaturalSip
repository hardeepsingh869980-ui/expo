// ---------- Cart Context ----------
const CartContext = createContext();

function useCart() {
  return useContext(CartContext);
}

function CartProvider({ children }) {
  const [items, setItems] = useState([]); // {id, qty, juice}

  function addToCart(juice, qty = 1) {
    setItems(prev => {
      const found = prev.find(i => i.id === juice.id);
      if (found) {
        return prev.map(i => (i.id === juice.id ? { ...i, qty: i.qty + qty } : i));
      }
      return [...prev, { id: juice.id, qty, juice }];
    });
  }

  function removeFromCart(juiceId) {
    setItems(prev => prev.filter(i => i.id !== juiceId));
  }

  function changeQty(juiceId, qty) {
    if (qty <= 0) return removeFromCart(juiceId);
    setItems(prev => prev.map(i => (i.id === juiceId ? { ...i, qty } : i)));
  }

  function clearCart() {
    setItems([]);
  }

  const subtotal = items.reduce((s, it) => s + it.qty * it.juice.price, 0);

  return (
    <CartContext.Provider value={{ items, addToCart, removeFromCart, changeQty, clearCart, subtotal }}>
      {children}
    </CartContext.Provider>
  );
}

